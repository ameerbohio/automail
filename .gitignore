# Secrets & certificates (never commit the generated material -- the
# generator scripts under infra/certs/*.sh are tracked, the key/cert
# output they produce is not)
.env
.env.*
!.env.example
*.pem
*.key
*.srl
infra/certs/*
!infra/certs/*.sh
!infra/certs/.gitkeep

# Go
bin/
*.test
*.out
/services/cloud/cloud
/services/printer/printer

# Node / Next.js
node_modules/
.next/
out/
npm-debug.log*
yarn-error.log*

# Data volumes / local state
*.log
data/
# ...but the Kubernetes data-tier manifests are source, not local state. The
# bare `data/` above matches a directory at any depth, so without this
# exception `infra/k8s/base/data/*.yaml` (the Postgres/Redis/MinIO
# StatefulSets, Goal K2) is silently untracked -- the kind of miss that only
# shows up when a clean clone renders an empty overlay. The negation must name
# the directory: git cannot re-include a file whose parent directory is
# excluded.
!infra/k8s/base/data/

# OS / editor
.DS_Store
Thumbs.db
.idea/
*.swp

# Claude local settings (machine-specific)
.claude/settings.local.json

# TypeScript incremental build info (generated by tsc --noEmit)
*.tsbuildinfo

# Vitest coverage output
services/portal/coverage/

# Playwright E2E artifacts (Goal T7)
services/portal/test-results/
services/portal/playwright-report/
services/portal/blob-report/
services/portal/.playwright/

# Regenerated crypto-contract vectors (Goal T2); fixture.json IS committed
testdata/crypto-contract/*.vector.json

# Load-run reports (Goal T10); baseline.json + testdata/ ARE committed
scripts/load/report/

# Personal notes (interview prep, resume drafts) -- deliberately not published
notes/
