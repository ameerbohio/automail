# Pinned versions and fixed addresses for the Kubernetes track (Goal K1).
# Sourced by every script in scripts/k8s/. Plain `KEY=value` only -- no
# expansion, no command substitution; validate.sh parses it as data too.
#
# Why pins: an unpinned k3d/kubectl/k3s turns "the cluster broke" into a
# three-way version bisect, and the bundled Traefik version (a function of the
# k3s tag) is what K4's ingress manifests are written against.

# Tooling installed by scripts/k8s/tools.sh into ~/.local/bin (no sudo).
K3D_VERSION=v5.9.0
KUBECTL_VERSION=v1.33.13

# Cluster. K3S_IMAGE must match `image:` in infra/k8s/k3d-cluster.yaml;
# scripts/k8s/up.sh asserts it. kubectl is held to the same minor as k3s --
# inside the ±1 skew policy, and one less thing to explain when something odd
# happens.
K3S_IMAGE=rancher/k3s:v1.33.13-k3s2
CLUSTER_NAME=automail

# Image tags imported with `k3d image import` (no registry in this cluster).
# Never `:latest` -- Kubernetes forces imagePullPolicy Always on that tag, and
# a registry-less k3d answers with ImagePullBackOff.
CLOUD_IMAGE=automail/cloud-server:dev
PORTAL_IMAGE=automail/portal:dev

# Namespace every Automail object lives in, and the three Secret names the
# manifests reference by name only (Goal K2). scripts/k8s/secrets.sh creates
# them imperatively from infra/certs/, infra/traefik/ and .env -- no PEM or
# password ever enters a committed manifest. Two trust domains stay two
# Secrets: internal mTLS/JWT vs the browser-facing edge cert.
NAMESPACE=automail
CRED_SECRET=automail-credentials
CERT_SECRET=automail-certs
EDGE_SECRET=automail-edge-tls
# ConfigMap holding services/cloud/db/schema.sql, created from the canonical
# file by scripts/k8s/apply.sh (Kustomize cannot read outside its own root).
SCHEMA_CONFIGMAP=postgres-schema

# Host ports fixed at cluster-creation time (see infra/k8s/k3d-cluster.yaml).
# Recorded here so later goals and docs quote one source instead of guessing.
EDGE_HTTP_PORT=9080
EDGE_HTTPS_PORT=9443
KUBE_API_PORT=6445
# Printer dial-in (K5): host port -> NodePort on the server node.
MTLS_HOST_PORT=9843
MTLS_NODE_PORT=30843

# Load generator (K7). The upstream pin is the same one infra/compose/load.yml
# uses, so the Compose and Kubernetes load runs execute on identical k6 builds.
# K6_IMAGE is a local re-tag of it: `k3d image import` cannot import a
# multi-platform image pulled from a registry (it fails with `ctr: content
# digest ... not found` and STILL exits 0), while a one-line `FROM` rebuild is
# single-platform and imports cleanly. scripts/k8s/load-check.sh builds and
# verifies it.
K6_UPSTREAM_IMAGE=grafana/k6:2.1.0
K6_IMAGE=automail/k6:2.1.0

# Offline manifest validation (scripts/k8s/validate.sh). kubeconform checks
# rendered manifests against the Kubernetes JSON schemas WITHOUT a cluster --
# which `kubectl apply --dry-run=client` cannot do, because it needs the
# discovery API to map kinds to resources. KUBECONFORM_K8S_VERSION is the schema
# set to validate against and tracks K3S_IMAGE's minor.
KUBECONFORM_VERSION=v0.8.0
KUBECONFORM_K8S_VERSION=1.33.0
